#!/usr/bin/env bash
# ===========================================================================
# Congen - Automated KDE Connect Command Generator & Management Tool
# Dual-format Qt 6 (@ByteArray JSON) & Legacy INI Engine
# ===========================================================================

set -eo pipefail

# ---------------------------------------------------------------------------
# Global Paths & Environment
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KDECONNECT_CFG_DIR="${HOME}/.config/kdeconnect"
BACKUP_DIR="${HOME}/.config/kdeconnect_backups"
MANUAL_FILE="${SCRIPT_DIR}/Congen_Commands_List.txt"
LOG_FILE="${SCRIPT_DIR}/Congen.log"

# Terminal formatting
BOLD="\033[1m"
DIM="\033[2m"
RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
CYAN="\033[36m"
WHITE="\033[37m"
RESET="\033[0m"

# ---------------------------------------------------------------------------
# Helpers & Utilities
# ---------------------------------------------------------------------------
hr() {
    local char="${1:-─}"
    printf '%*s' 60 '' | tr ' ' "${char}"
}

press_enter() {
    echo ""
    read -rp "  Press [Enter] to continue..." _
}

log_entry() {
    local msg="$1"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    mkdir -p "$(dirname "${LOG_FILE}")"
    echo "[${timestamp}] ${msg}" >> "${LOG_FILE}"
}

get_qdbus_bin() {
    if command -v qdbus6 &>/dev/null; then
        echo "qdbus6"
    elif command -v qdbus &>/dev/null; then
        echo "qdbus"
    else
        echo ""
    fi
}

# ---------------------------------------------------------------------------
# Banner & System Diagnostics
# ---------------------------------------------------------------------------
show_banner() {
    clear
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo -e "${CYAN}║${RESET}  ${BOLD}${WHITE}CONGEN${RESET} — KDE Connect Command Management Utility"
    echo -e "${CYAN}$(hr '═')${RESET}"
    echo ""
}

# ---------------------------------------------------------------------------
# Device Discovery (Filters out backups and plugins, supports "All")
# ---------------------------------------------------------------------------
get_paired_device_dirs() {
    local -a valid_dirs=()
    if [[ ! -d "${KDECONNECT_CFG_DIR}" ]]; then
        return 0
    fi
    while IFS= read -r -d '' d; do
        local bname
        bname="$(basename "${d}")"
        if [[ -f "${d}/config" && "${bname}" != "backups" && ! "${bname}" =~ ^kdeconnect_ ]]; then
            valid_dirs+=("${d}")
        fi
    done < <(find "${KDECONNECT_CFG_DIR}" -mindepth 1 -maxdepth 1 -type d -not -name "." -print0 2>/dev/null)
    printf '%s\n' "${valid_dirs[@]}"
}

pick_device_config_dirs() {
    local -a device_dirs=()
    while IFS= read -r line; do
        [[ -n "${line}" ]] && device_dirs+=("${line}")
    done < <(get_paired_device_dirs)

    if [[ ${#device_dirs[@]} -eq 0 ]]; then
        echo -e "\n  ${RED}No paired KDE Connect devices found.${RESET}" >&2
        echo -e "  ${DIM}Pair a device first via KDE Connect, then re-run Congen.${RESET}\n" >&2
        return 1
    fi

    echo -e "  ${BOLD}${CYAN}Paired Devices:${RESET}\n" >&2
    local i=1
    for dir in "${device_dirs[@]}"; do
        local dev_id dev_name name_file
        dev_id="$(basename "${dir}")"
        name_file="${dir}/config"
        dev_name="${dev_id}"
        if [[ -f "${name_file}" ]]; then
            dev_name=$(grep -i '^name=' "${name_file}" 2>/dev/null | head -1 | cut -d'=' -f2- || echo "${dev_id}")
        fi
        printf "    ${YELLOW}[%d]${RESET} %s  ${DIM}(ID: %s)${RESET}\n" "${i}" "${dev_name}" "${dev_id}" >&2
        (( i++ ))
    done
    printf "    ${YELLOW}[a]${RESET} %s\n\n" "${BOLD}All Devices${RESET}" >&2

    local choice
    while true; do
        read -rp "  Select device [1-${#device_dirs[@]}, a for all]: " choice
        choice="${choice,,}"
        if [[ "${choice}" == "a" || "${choice}" == "all" ]]; then
            for dir in "${device_dirs[@]}"; do
                local p_dir="${dir}/kdeconnect_runcommand"
                mkdir -p "${p_dir}"
                echo "${p_dir}"
            done
            return 0
        elif [[ "${choice}" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#device_dirs[@]} )); then
            local selected="${device_dirs[$(( choice - 1 ))]}"
            local p_dir="${selected}/kdeconnect_runcommand"
            mkdir -p "${p_dir}"
            echo "${p_dir}"
            return 0
        fi
        echo -e "  ${RED}Invalid selection.${RESET} Enter 1-${#device_dirs[@]} or 'a'." >&2
    done
}

# ---------------------------------------------------------------------------
# Reload KDE Connect over D-Bus
# ---------------------------------------------------------------------------
reload_kdeconnect() {
    local qdbus_bin
    qdbus_bin="$(get_qdbus_bin)"
    [[ -z "${qdbus_bin}" ]] && return 0

    local -a device_dirs=()
    while IFS= read -r line; do
        [[ -n "${line}" ]] && device_dirs+=("${line}")
    done < <(get_paired_device_dirs)

    for d in "${device_dirs[@]}"; do
        local dev_id
        dev_id="$(basename "${d}")"
        "${qdbus_bin}" org.kde.kdeconnect "/modules/kdeconnect/devices/${dev_id}/runcommand" \
            org.kde.kdeconnect.device.runcommand.reload &>/dev/null || true
        "${qdbus_bin}" org.kde.kdeconnect "/modules/kdeconnect/devices/${dev_id}" \
            org.kde.kdeconnect.device.reloadPlugins &>/dev/null || true
    done

    "${qdbus_bin}" org.kde.kdeconnect /modules/kdeconnect \
        org.kde.kdeconnect.daemon.forceOnNetworkChange &>/dev/null || true
}

# ---------------------------------------------------------------------------
# Dual Write Engine (Qt 6 @ByteArray + Legacy INI)
# ---------------------------------------------------------------------------
write_command_to_config() {
    local cfg="$1"
    local key="$2"
    local name="$3"
    local script="$4"

    mkdir -p "$(dirname "${cfg}")"
    [[ ! -f "${cfg}" ]] && touch "${cfg}"

    python3 - "${cfg}" "${key}" "${name}" "${script}" <<'PYEOF'
import sys, os, re, json, uuid

cfg_path, key, name, script = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
clean_script = script.replace("\r", "").replace("\n", "").strip()

lines = []
if os.path.isfile(cfg_path):
    try:
        with open(cfg_path, "r", encoding="utf-8", errors="ignore") as f:
            lines = f.readlines()
    except Exception:
        lines = []

json_dict = {}
commands_line_idx = -1

for idx, line in enumerate(lines):
    l_strip = line.strip()
    if l_strip.startswith("commands="):
        commands_line_idx = idx
        raw = l_strip[len("commands="):].strip()
        if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
            raw = raw[1:-1].strip()
        if raw.startswith("@ByteArray(") and raw.endswith(")"):
            raw = raw[len("@ByteArray("):-1].strip()
        if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
            raw = raw[1:-1].strip()
        if r'\"' in raw:
            raw = raw.replace(r'\"', '"')
        try:
            parsed = json.loads(raw)
            if isinstance(parsed, str):
                parsed = json.loads(parsed)
            if isinstance(parsed, dict):
                json_dict = parsed
        except Exception:
            pass
        break

found_uuid = None
for u, entry in json_dict.items():
    if isinstance(entry, dict) and entry.get("name") == name:
        found_uuid = u
        break

if not found_uuid:
    found_uuid = str(uuid.uuid4()).replace("-", "_")

json_dict[found_uuid] = {
    "name": name,
    "command": clean_script
}

compact_json = json.dumps(json_dict, separators=(',', ':'))
escaped_json = compact_json.replace('"', '\\"')
new_bytearray_line = f'commands="@ByteArray({escaped_json})"\n'

has_general = any(l.strip() == "[General]" for l in lines)

if commands_line_idx != -1:
    lines[commands_line_idx] = new_bytearray_line
    if not has_general:
        lines.insert(commands_line_idx, "[General]\n")
else:
    gen_idx = -1
    for idx, l in enumerate(lines):
        if l.strip() == "[General]":
            gen_idx = idx
            break
    if gen_idx != -1:
        lines.insert(gen_idx + 1, new_bytearray_line)
    else:
        lines.insert(0, "[General]\n" + new_bytearray_line)

content = "".join(lines)
sec_re = re.compile(r'(\[commands\])(.*?)(?=\n\[|\Z)', re.DOTALL | re.IGNORECASE)
m = sec_re.search(content)

new_name_line = f"{key}\\name={name}\n"
new_cmd_line = f"{key}\\command={clean_script}\n"

if m:
    body = m.group(2)
    body = re.sub(rf'^{re.escape(key)}\\name=.*\n?', '', body, flags=re.MULTILINE)
    body = re.sub(rf'^{re.escape(key)}\\command=.*\n?', '', body, flags=re.MULTILINE)
    body = body.rstrip() + "\n" + new_name_line + new_cmd_line
    content = content[:m.start()] + m.group(1) + body + content[m.end():]
else:
    content = content.rstrip() + f"\n\n[commands]\n{new_name_line}{new_cmd_line}"

with open(cfg_path, "w", encoding="utf-8") as f:
    f.write(content)
PYEOF
}

# ---------------------------------------------------------------------------
# Synchronized Removal Engine
# ---------------------------------------------------------------------------
remove_command_from_config() {
    local cfg="$1"
    local key="$2"
    local name="$3"

    python3 - "${cfg}" "${key}" "${name}" <<'PYEOF'
import sys, re, json, os

cfg_path = sys.argv[1]
key      = sys.argv[2]
cmd_name = sys.argv[3].strip() if len(sys.argv) > 3 else ""

if not os.path.isfile(cfg_path):
    sys.exit(0)

with open(cfg_path, 'r', encoding='utf-8', errors='ignore') as f:
    lines = f.readlines()

content = "".join(lines)

# 1. Clean legacy [commands] section
sec_re = re.compile(r'(\[commands\])(.*?)(?=\n\[|\Z)', re.DOTALL | re.IGNORECASE)
m = sec_re.search(content)
if m:
    body = m.group(2)
    if key:
        body = re.sub(rf'^{re.escape(key)}\\name=.*\n?',    '', body, flags=re.MULTILINE)
        body = re.sub(rf'^{re.escape(key)}\\command=.*\n?', '', body, flags=re.MULTILINE)
    if cmd_name:
        body = re.sub(rf'^cmd[0-9]+\\name={re.escape(cmd_name)}\n?', '', body, flags=re.MULTILINE)
    content = content[:m.start()] + m.group(1) + body + content[m.end():]
    lines = [l + "\n" for l in content.splitlines()]

# 2. Clean modern @ByteArray
new_lines = []
for line in lines:
    l_strip = line.strip()
    if l_strip.startswith("commands="):
        raw = l_strip[len("commands="):].strip()
        if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
            raw = raw[1:-1].strip()
        if raw.startswith("@ByteArray(") and raw.endswith(")"):
            raw = raw[len("@ByteArray("):-1].strip()
        if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
            raw = raw[1:-1].strip()
        if r'\"' in raw:
            raw = raw.replace(r'\"', '"')
        try:
            parsed = json.loads(raw)
            if isinstance(parsed, str):
                parsed = json.loads(parsed)
            if isinstance(parsed, dict):
                del_keys = [
                    u for u, d in parsed.items()
                    if isinstance(d, dict) and (d.get("name") == cmd_name or u == key)
                ]
                for u in del_keys:
                    del parsed[u]

                compact_json = json.dumps(parsed, separators=(',', ':'))
                escaped_json = compact_json.replace('"', '\\"')
                new_lines.append(f'commands="@ByteArray({escaped_json})"\n')
                continue
        except Exception:
            pass
    new_lines.append(line)

with open(cfg_path, 'w', encoding='utf-8') as f:
    f.writelines(new_lines)
PYEOF
}

# ---------------------------------------------------------------------------
# Manual & Documentation Operations
# ---------------------------------------------------------------------------
update_manual() {
    local name="$1"
    local script="$2"
    local summary="$3"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"

    mkdir -p "$(dirname "${MANUAL_FILE}")"
    {
        echo "────────────────────────────────────────────────────────────"
        echo "  Command Name : ${name}"
        echo "  Script       : ${script}"
        echo "  Summary      : ${summary}"
        echo "  Added        : ${timestamp}"
        echo "────────────────────────────────────────────────────────────"
    } >> "${MANUAL_FILE}"
}

remove_from_manual() {
    local target_name="$1"
    [[ ! -f "${MANUAL_FILE}" ]] && return 0

    python3 - "${MANUAL_FILE}" "${target_name}" <<'PYEOF'
import sys, re
path, target = sys.argv[1], sys.argv[2].strip()
with open(path, 'r', errors='ignore') as f:
    content = f.read()

blocks = re.split(r'─{10,}', content)
out = []
for b in blocks:
    m = re.search(r'Command Name\s*:\s*(.+)', b)
    if m and m.group(1).strip() == target:
        continue
    stripped = b.strip()
    if stripped:
        out.append(f"────────────────────────────────────────────────────────────\n{stripped}\n────────────────────────────────────────────────────────────\n")

with open(path, 'w') as f:
    f.write("".join(out))
PYEOF
}

# ---------------------------------------------------------------------------
# Command Collection (Merges @ByteArray and legacy INI)
# ---------------------------------------------------------------------------
collect_all_commands() {
    CMD_KEYS=()
    CMD_NAMES=()
    CMD_SCRIPTS=()
    CMD_DEVICES=()
    CMD_CFGS=()

    while IFS= read -r -d '' cfg_file; do
        local p_dir dev_dir dev_cfg dev_name
        p_dir="$(dirname "${cfg_file}")"
        dev_dir="$(dirname "${p_dir}")"
        dev_cfg="${dev_dir}/config"
        dev_name="$(basename "${dev_dir}")"
        if [[ -f "${dev_cfg}" ]]; then
            dev_name=$(grep -i '^name=' "${dev_cfg}" 2>/dev/null | head -1 | cut -d'=' -f2- || echo "${dev_name}")
        fi

        # Parse both JSON and INI entries
        python3 - "${cfg_file}" "${dev_name}" <<'PYEOF'
import sys, json, re

cfg_path, dev_name = sys.argv[1], sys.argv[2]
entries = {} # name -> (key, script)

try:
    with open(cfg_path, 'r', encoding='utf-8', errors='ignore') as f:
        content = f.read()
except Exception:
    sys.exit(0)

# 1. Parse @ByteArray
for line in content.splitlines():
    l_strip = line.strip()
    if l_strip.startswith("commands="):
        raw = l_strip[len("commands="):].strip()
        if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
            raw = raw[1:-1].strip()
        if raw.startswith("@ByteArray(") and raw.endswith(")"):
            raw = raw[len("@ByteArray("):-1].strip()
        if (raw.startswith('"') and raw.endswith('"')) or (raw.startswith("'") and raw.endswith("'")):
            raw = raw[1:-1].strip()
        if r'\"' in raw:
            raw = raw.replace(r'\"', '"')
        try:
            parsed = json.loads(raw)
            if isinstance(parsed, str):
                parsed = json.loads(parsed)
            if isinstance(parsed, dict):
                for u, d in parsed.items():
                    if isinstance(d, dict) and "name" in d and "command" in d:
                        entries[d["name"]] = (u, d["command"])
        except Exception:
            pass
        break

# 2. Parse INI commands block
sec_re = re.compile(r'\[commands\](.*?)(?=\n\[|\Z)', re.DOTALL | re.IGNORECASE)
m = sec_re.search(content)
if m:
    names, cmds = {}, {}
    for line in m.group(1).splitlines():
        line = line.strip()
        if r'\name=' in line:
            k, v = line.split(r'\name=', 1)
            names[k.strip()] = v.strip()
        elif r'\command=' in line:
            k, v = line.split(r'\command=', 1)
            cmds[k.strip()] = v.strip()
    for k, n in names.items():
        if n not in entries:
            entries[n] = (k, cmds.get(k, ""))

for n, (k, s) in entries.items():
    print(f"{k}\t{n}\t{s}\t{dev_name}\t{cfg_path}")
PYEOF
    done < <(find "${KDECONNECT_CFG_DIR}" -name "config" -path "*/kdeconnect_runcommand/*" -print0 2>/dev/null)
}

load_collected_arrays() {
    CMD_KEYS=()
    CMD_NAMES=()
    CMD_SCRIPTS=()
    CMD_DEVICES=()
    CMD_CFGS=()

    while IFS=$'\t' read -r k n s d c; do
        [[ -z "${k}" ]] && continue
        CMD_KEYS+=("${k}")
        CMD_NAMES+=("${n}")
        CMD_SCRIPTS+=("${s}")
        CMD_DEVICES+=("${d}")
        CMD_CFGS+=("${c}")
    done < <(collect_all_commands)
}

# ---------------------------------------------------------------------------
# Create Command Workflow
# ---------------------------------------------------------------------------
create_command() {
    show_banner
    echo -e "  ${BOLD}── Create New KDE Connect Command ──${RESET}\n"

    local cmd_name=""
    while [[ -z "${cmd_name}" ]]; do
        read -rp "  Command Name (label shown in mobile app): " cmd_name
        cmd_name="$(echo "${cmd_name}" | xargs)"
        [[ -z "${cmd_name}" ]] && echo -e "  ${RED}Command name cannot be empty.${RESET}"
    done

    echo ""
    local script_path=""
    while true; do
        read -rp "  Full Path to Script: " script_path
        script_path="$(echo "${script_path}" | xargs)"
        eval script_path="${script_path}"

        if [[ ! -f "${script_path}" ]]; then
            echo -e "  ${YELLOW}⚠  Warning:${RESET} Script '${script_path}' not found."
            read -rp "  Register anyway? [y/N]: " anyway
            [[ "${anyway,,}" == "y" ]] && break
            continue
        fi

        # Executable check and auto chmod
        if [[ ! -x "${script_path}" ]]; then
            echo -e "  ${YELLOW}⚠  Script is not executable. Setting chmod +x...${RESET}"
            chmod +x "${script_path}" && echo -e "  ${GREEN}✔ Executable permission set.${RESET}"
        fi
        break
    done

    echo ""
    local summary=""
    while [[ -z "${summary}" ]]; do
        read -rp "  Brief Summary of command: " summary
        summary="$(echo "${summary}" | xargs)"
        [[ -z "${summary}" ]] && echo -e "  ${RED}Summary cannot be empty.${RESET}"
    done

    echo ""
    local -a target_dirs=()
    while IFS= read -r dir; do
        [[ -n "${dir}" ]] && target_dirs+=("${dir}")
    done < <(pick_device_config_dirs)

    [[ ${#target_dirs[@]} -eq 0 ]] && return 1

    echo ""
    for p_dir in "${target_dirs[@]}"; do
        local cfg_file="${p_dir}/config"
        local dev_id dev_name dev_cfg
        dev_id="$(basename "$(dirname "${p_dir}")")"
        dev_cfg="$(dirname "${p_dir}")/config"
        dev_name="${dev_id}"
        if [[ -f "${dev_cfg}" ]]; then
            dev_name=$(grep -i '^name=' "${dev_cfg}" 2>/dev/null | head -1 | cut -d'=' -f2- || echo "${dev_id}")
        fi

        echo -e "  ${DIM}Writing '${cmd_name}' → ${dev_name}...${RESET}"
        write_command_to_config "${cfg_file}" "cmd$RANDOM" "${cmd_name}" "${script_path}"
        log_entry "CREATED command '${cmd_name}' | script='${script_path}' | device='${dev_name}'"
    done

    update_manual "${cmd_name}" "${script_path}" "${summary}"
    reload_kdeconnect

    echo -e "\n  ${GREEN}${BOLD}✔ Successfully registered and reloaded across all target devices.${RESET}"
    press_enter
}

# ---------------------------------------------------------------------------
# View, Edit & Delete Commands Workflow
# ---------------------------------------------------------------------------
view_installed_commands() {
    while true; do
        show_banner
        load_collected_arrays
        local total="${#CMD_KEYS[@]}"

        if [[ ${total} -eq 0 ]]; then
            echo -e "  ${YELLOW}No KDE Connect run-commands currently found.${RESET}"
            press_enter
            return
        fi

        echo -e "  ${BOLD}Installed Commands (${YELLOW}${total}${RESET}${BOLD}):${RESET}\n"
        echo -e "  ${DIM}$(hr '─')${RESET}"

        for (( i=0; i<total; i++ )); do
            local idx=$(( i + 1 ))
            local status="${GREEN}✔ exists${RESET}"
            [[ ! -f "${CMD_SCRIPTS[$i]}" ]] && status="${RED}✘ missing on disk${RESET}"

            printf "  ${YELLOW}${BOLD}[%d]${RESET}  ${BOLD}%s${RESET}  ${DIM}(%s)${RESET}\n" "${idx}" "${CMD_NAMES[$i]}" "${CMD_DEVICES[$i]}"
            printf "       %-12s %s (%b)\n" "Script:" "${CMD_SCRIPTS[$i]}" "${status}"
            printf "       %-12s %s\n" "Key:" "${CMD_KEYS[$i]}"
            echo -e "  ${DIM}$(hr '─')${RESET}"
        done

        echo -e "\n  ${BOLD}Options:${RESET}"
        echo -e "    ${YELLOW}[d <#>]${RESET} Delete command (e.g. 'd 1')"
        echo -e "    ${YELLOW}[e <#>]${RESET} Edit script path / name"
        echo -e "    ${YELLOW}[b]${RESET}     Back to Main Menu\n"

        local action
        read -rp "  Select option: " action
        [[ "${action,,}" == "b" || -z "${action}" ]] && return

        if [[ "${action,,}" =~ ^d\ +([0-9]+)$ ]]; then
            local num="${BASH_REMATCH[1]}"
            if (( num >= 1 && num <= total )); then
                local s_idx=$(( num - 1 ))
                local r_cfg="${CMD_CFGS[$s_idx]}"
                local r_key="${CMD_KEYS[$s_idx]}"
                local r_name="${CMD_NAMES[$s_idx]}"

                read -rp "  Type 'yes' to confirm deleting '${r_name}': " confirm
                if [[ "${confirm,,}" == "yes" ]]; then
                    remove_command_from_config "${r_cfg}" "${r_key}" "${r_name}"
                    remove_from_manual "${r_name}"
                    log_entry "REMOVED command '${r_name}' | cfg='${r_cfg}'"
                    reload_kdeconnect
                    echo -e "  ${GREEN}Deleted.${RESET}"
                    sleep 1
                fi
            fi
        elif [[ "${action,,}" =~ ^e\ +([0-9]+)$ ]]; then
            local num="${BASH_REMATCH[1]}"
            if (( num >= 1 && num <= total )); then
                local s_idx=$(( num - 1 ))
                local e_cfg="${CMD_CFGS[$s_idx]}"
                local e_key="${CMD_KEYS[$s_idx]}"
                local e_name="${CMD_NAMES[$s_idx]}"
                local e_script="${CMD_SCRIPTS[$s_idx]}"

                echo -e "\n  Editing: ${BOLD}${e_name}${RESET}"
                read -rp "  New Name [Enter to keep '${e_name}']: " new_name
                [[ -z "${new_name}" ]] && new_name="${e_name}"

                read -rp "  New Script Path [Enter to keep '${e_script}']: " new_script
                [[ -z "${new_script}" ]] && new_script="${e_script}"

                if [[ ! -x "${new_script}" && -f "${new_script}" ]]; then
                    chmod +x "${new_script}"
                fi

                remove_command_from_config "${e_cfg}" "${e_key}" "${e_name}"
                write_command_to_config "${e_cfg}" "${e_key}" "${new_name}" "${new_script}"
                reload_kdeconnect
                echo -e "  ${GREEN}Updated.${RESET}"
                sleep 1
            fi
        fi
    done
}

# ---------------------------------------------------------------------------
# CLI Non-Interactive Execution Mode
# ---------------------------------------------------------------------------
cli_mode() {
    case "$1" in
        --list|-l)
            load_collected_arrays
            printf "%-5s | %-20s | %-20s | %s\n" "NUM" "NAME" "DEVICE" "SCRIPT"
            echo "--------------------------------------------------------------------------------"
            for (( i=0; i<${#CMD_KEYS[@]}; i++ )); do
                printf "%-5d | %-20s | %-20s | %s\n" "$((i+1))" "${CMD_NAMES[$i]}" "${CMD_DEVICES[$i]}" "${CMD_SCRIPTS[$i]}"
            done
            exit 0
            ;;
        --reload|-r)
            reload_kdeconnect
            echo "KDE Connect plugins reloaded and network notified."
            exit 0
            ;;
        --add|-a)
            shift
            local c_name="" c_script="" c_summary="Managed via CLI" c_target="all"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --name|-n) c_name="$2"; shift 2 ;;
                    --path|-p) c_script="$2"; shift 2 ;;
                    --summary|-s) c_summary="$2"; shift 2 ;;
                    --target|-t) c_target="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done

            if [[ -z "${c_name}" || -z "${c_script}" ]]; then
                echo "Error: --name and --path are required for --add"
                exit 1
            fi

            if [[ -f "${c_script}" && ! -x "${c_script}" ]]; then
                chmod +x "${c_script}"
            fi

            local -a targets=()
            while IFS= read -r d; do
                if [[ -n "${d}" ]]; then
                    if [[ "${c_target}" == "all" || "$(basename "${d}")" == *"${c_target}"* ]]; then
                        targets+=("${d}/kdeconnect_runcommand")
                    fi
                fi
            done < <(get_paired_device_dirs)

            for p_dir in "${targets[@]}"; do
                mkdir -p "${p_dir}"
                write_command_to_config "${p_dir}/config" "cmd$RANDOM" "${c_name}" "${c_script}"
            done
            update_manual "${c_name}" "${c_script}" "${c_summary}"
            reload_kdeconnect
            echo "Command '${c_name}' successfully added."
            exit 0
            ;;
        --delete|-d)
            shift
            local d_name="$1"
            if [[ -z "${d_name}" ]]; then
                echo "Error: Command name required for --delete"
                exit 1
            fi
            while IFS= read -r -d '' cfg; do
                remove_command_from_config "${cfg}" "" "${d_name}"
            done < <(find "${KDECONNECT_CFG_DIR}" -name "config" -path "*/kdeconnect_runcommand/*" -print0 2>/dev/null)
            remove_from_manual "${d_name}"
            reload_kdeconnect
            echo "Command '${d_name}' deleted across all targets."
            exit 0
            ;;
        --help|-h)
            echo "Congen CLI Usage:"
            echo "  ./Congen                                  Interactive TUI"
            echo "  ./Congen --list                           List installed commands"
            echo "  ./Congen --reload                         Reload KDE Connect D-Bus"
            echo "  ./Congen --add -n <name> -p <path> [-t all] Add command non-interactively"
            echo "  ./Congen --delete <name>                  Delete command by name"
            exit 0
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Main Interactive Menu
# ---------------------------------------------------------------------------
main_menu() {
    while true; do
        show_banner
        echo -e "  ${BOLD}Main Menu${RESET}\n"
        echo -e "    ${YELLOW}[1]${RESET}  Create new KDE Connect command (supports All Devices)"
        echo -e "    ${YELLOW}[2]${RESET}  View, Edit, or Remove installed commands"
        echo -e "    ${YELLOW}[3]${RESET}  Reload KDE Connect D-Bus state"
        echo -e "    ${YELLOW}[4]${RESET}  View Congen Log"
        echo -e "    ${YELLOW}[q]${RESET}  Quit\n"

        local opt
        read -rp "  Select option: " opt
        case "${opt,,}" in
            1) create_command ;;
            2) view_installed_commands ;;
            3) reload_kdeconnect && echo -e "  ${GREEN}Reload dispatched.${RESET}" && sleep 1 ;;
            4) [[ -f "${LOG_FILE}" ]] && less "${LOG_FILE}" || press_enter ;;
            q|quit|exit)
                echo -e "\n  ${DIM}Goodbye.${RESET}\n"
                exit 0
                ;;
            *)
                echo -e "\n  ${RED}Invalid option.${RESET}"
                sleep 1
                ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Entry Point
# ---------------------------------------------------------------------------
log_entry "Session started. Script: ${BASH_SOURCE[0]}"

if [[ $# -gt 0 ]]; then
    cli_mode "$@"
fi

main_menu
